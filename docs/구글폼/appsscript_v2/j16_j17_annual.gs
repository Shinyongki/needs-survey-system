// ---------------------------------------------------------------------------
// J16 유공자 표창 (10문항)
// ---------------------------------------------------------------------------
function createJ16Form() {
  const form = FormApp.create('J16 유공자 표창 현장설문');
  form.setDescription(
    '본 설문은 이번 유공자 표창 추천 절차에 대한 의견을 수렴하기 위한 것입니다.\n' +
    '응답은 개인별로 수집되며 분석 외 목적으로 사용되지 않습니다.\n' +
    '총 10문항으로 구성되어 있습니다.'
  );
  form.setProgressBar(true);

  // J16은 회차 문항 없음 — 도입부 3문항
  addFieldSurveyIntro(form, 'J16');

  addSection(form, '이번 표창 추천 평가',
    '다음 문항은 이번 유공자 표창 추천에 관한 내용입니다.');

  addAgreeScale(form, '[공통-1] 유공자 추천 기준과 절차 안내가 충분하였습니까?');
  addAgreeScale(form, '[공통-2] 추천 절차 진행 과정에서 광역 담당자의 응대가 신속하였습니까?');
  addAgreeScale(form, '[공통-3] 유공자 표창이 종사자 사기 진작에 도움이 되었습니까?');
  addSatisfyScale(form, '[공통-4] 유공자 표창 운영에 대한 종합 만족도는 어느 정도입니까?');

  addAgreeScale(form, '[F2-1] 공적조서 작성 가이드가 실무에 도움이 되었습니까?');
  addAgreeScale(form, '[F2-2] 추천 경험이 향후 유공자 발굴·추천에 도움이 되겠습니까?');
  addLongText(form, '[F2-3] 표창 관련 광역에 바라는 점 또는 종사자 자긍심 제고를 위해 추진했으면 하는 행사를 적어주세요.');

  const ss = attachSpreadsheet(form, '[응답] J16 유공자 표창');
  const mappings = getFieldIntroMappings('J16').concat([
    { title: '[공통-1] 유공자 추천 기준과 절차 안내가 충분하였습니까?', code: '공통-1' },
    { title: '[공통-2] 추천 절차 진행 과정에서 광역 담당자의 응대가 신속하였습니까?', code: '공통-2' },
    { title: '[공통-3] 유공자 표창이 종사자 사기 진작에 도움이 되었습니까?', code: '공통-3' },
    { title: '[공통-4] 유공자 표창 운영에 대한 종합 만족도는 어느 정도입니까?', code: '공통-4' },
    { title: '[F2-1] 공적조서 작성 가이드가 실무에 도움이 되었습니까?', code: 'F2-1' },
    { title: '[F2-2] 추천 경험이 향후 유공자 발굴·추천에 도움이 되겠습니까?', code: 'F2-2' },
    { title: '[F2-3] 표창 관련 광역에 바라는 점 또는 종사자 자긍심 제고를 위해 추진했으면 하는 행사를 적어주세요.', code: 'F2-3' }
  ]);
  createHeaderMapping(ss, mappings);

  Logger.log('J16 생성 완료: ' + form.getEditUrl());
  return { form: form, ss: ss };
}

// ---------------------------------------------------------------------------
// J17 종사자 지원사업 (10문항)
// ---------------------------------------------------------------------------
function createJ17Form() {
  const form = FormApp.create('J17 종사자 지원사업 현장설문');
  form.setDescription(
    '본 설문은 이번 종사자 지원사업에 대한 의견을 수렴하기 위한 것입니다.\n' +
    '※ 중앙→광역(중간 전달)→수행기관 구조입니다.\n' +
    '응답은 개인별로 수집되며 분석 외 목적으로 사용되지 않습니다.\n' +
    '총 10문항으로 구성되어 있습니다.'
  );
  form.setProgressBar(true);

  // J17도 회차 문항 없음 — 도입부 3문항
  addFieldSurveyIntro(form, 'J17');

  addSection(form, '이번 지원사업 평가',
    '다음 문항은 이번 종사자 지원사업에 관한 내용입니다.');

  addAgreeScale(form, '[공통-1] 종사자 지원사업 관련 광역의 사전 안내가 충분하고 적시에 제공되었습니까?');
  addAgreeScale(form, '[공통-2] 신청 절차 진행 과정에서 광역 담당자의 응대가 신속하였습니까?');
  addAgreeScale(form, '[공통-3] 광역의 종사자 지원사업 중간 전달·안내가 수행기관 운영에 실질적으로 도움이 되었습니까?');
  addSatisfyScale(form, '[공통-4] 종사자 지원사업에 대한 종합 만족도는 어느 정도입니까?');

  addAgreeScale(form, '[F3-1] 광역을 통해 전달받은 종사자 지원사업 내용이 명확하게 이해되었습니까?');
  addAgreeScale(form, '[F3-2] 종사자 지원사업 참여를 위한 행정 절차가 간소하고 편리하였습니까?');
  addLongText(form, '[F3-3] 종사자 지원사업 관련 광역에 바라는 점을 적어주세요.');

  const ss = attachSpreadsheet(form, '[응답] J17 종사자 지원사업');
  const mappings = getFieldIntroMappings('J17').concat([
    { title: '[공통-1] 종사자 지원사업 관련 광역의 사전 안내가 충분하고 적시에 제공되었습니까?', code: '공통-1' },
    { title: '[공통-2] 신청 절차 진행 과정에서 광역 담당자의 응대가 신속하였습니까?', code: '공통-2' },
    { title: '[공통-3] 광역의 종사자 지원사업 중간 전달·안내가 수행기관 운영에 실질적으로 도움이 되었습니까?', code: '공통-3' },
    { title: '[공통-4] 종사자 지원사업에 대한 종합 만족도는 어느 정도입니까?', code: '공통-4' },
    { title: '[F3-1] 광역을 통해 전달받은 종사자 지원사업 내용이 명확하게 이해되었습니까?', code: 'F3-1' },
    { title: '[F3-2] 종사자 지원사업 참여를 위한 행정 절차가 간소하고 편리하였습니까?', code: 'F3-2' },
    { title: '[F3-3] 종사자 지원사업 관련 광역에 바라는 점을 적어주세요.', code: 'F3-3' }
  ]);
  createHeaderMapping(ss, mappings);

  Logger.log('J17 생성 완료: ' + form.getEditUrl());
  return { form: form, ss: ss };
}
